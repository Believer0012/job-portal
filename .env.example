NODE_ENV=development
PORT=5000

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-your-local-postgres-password"
DATABASE_URL="postgresql://postgres:replace-with-your-local-postgres-password@localhost:5432/jobportal"
DATABASE_ADMIN_URL="postgresql://postgres:replace-with-your-local-postgres-password@localhost:5432/postgres"

CLIENT_URL="http://localhost:5173"
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-a-different-secure-secret"
JWT_REFRESH_EXPIRES_IN="7d"
REFRESH_COOKIE_NAME="jobportal_refresh_token"
REFRESH_COOKIE_MAX_AGE_MS="604800000"

SEED_ADMIN_EMAIL="admin@jobportal.local"
SEED_ADMIN_PASSWORD="replace-with-a-development-password"

# Optional: seeds a USER role account for manual testing of the job application flow.
SEED_USER_EMAIL="user@jobportal.local"
SEED_USER_PASSWORD="replace-with-a-development-password"